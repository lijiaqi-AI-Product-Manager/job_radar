e,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":false,"Channel4SequenceNumber":"","ChangeDate":"2026-09-15T18:07:12","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null},{"Id":"29edefe8-ea89-4b5e-9d50-d20ee2d1343c","HeadCount":0,"JobAdId":351613929,"PostDateInt":0,"PostDate":"0001-01-01T00:00:00","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"RD37 临床工程师（生命信息与支持）（动物医疗）(J19101)","OrgId":700157844,"Org":null,"Category":null,"CategoryId":"2","LocId":null,"LocNames":[],"Salary":null,"Duty":"本岗位是连接学术-临床-研发的枢纽，专职跟踪急重症学科前沿发展，深度挖掘临床痛点，完成临床需求输入、专家临床基地运营、新产品/新功能的临床策划与验证，为产品线迭代提供专业临床输入，支撑急重症专科产品矩阵迭代，构筑产品临床壁垒，保障业务市场竞争力。\n\n1、跟踪国内外小动物急重症专科学术动态与行业热点，输出行业洞察，支撑业务规划。\n2、负责国内外急重症临床专家、临床研究基地的建设维护，推进医院学科共建、临床科研合作落地。\n3、调研国内外急重症临床真实场景，挖掘临床痛点，输出高质量临床需求，驱动产品创新。\n4、负责新产品、新功能的临床确认策划与落地，完成临床评估，保障产品适配临床真实使用。","Require":"1、动物医学相关专业硕士及以上学历。\r\n2、具备动物医院临床实习或工作经历，了解小动物临床，急重症方向背景优先。\r\n3、熟练文献检索解读，具备统计分析、调研分析能力。\r\n4、具备英语口语沟通能力及读写能力，有国际留学背景优先。\r\n5、热爱临床工程与临床研究工作，主动性强，沟通协作好，责任心强。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":null,"Channel4IsHot":false,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllow