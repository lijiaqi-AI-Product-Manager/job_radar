{"Code":200,"Message":"operation success","MoreMessage":"","TipType":"Success","Count":85,"ReturnUrl":null,"Data":[{"Id":"ff6b5079-d621-49cf-ac0c-6f3be3f2fe07","HeadCount":0,"JobAdId":621151152,"PostDateInt":0,"PostDate":"0001-01-01T00:00:00","EndTimeInt":0,"EndTime":"0001-01-01T00:00:00","JobAdName":"【2027届秋季校招】管培生（投资方向）","OrgId":1510225,"Org":null,"Category":null,"CategoryId":"5","LocId":null,"LocNames":[],"Salary":null,"Duty":"为公司自营业务核心战略人才储备项目，定向为自营投资条线培养专业化投资人才。协助搭建、完善自营投研体系，及时跟踪宏观基本面、监管政策及市场动向；协助完成交易相关研究，跟踪监控账户持仓情况，进行交易复盘与持仓分析，为自营投资决策提供支持；参与交易系统的建设、优化与迭代，支持业务高效开展。协助运用编程与AI工具开展数据清洗、因子挖掘、信息提炼等工作，参与AI投研工具建设与迭代。","Require":"硕士研究生及以上学历，专业不限，优先考虑具备理工复合专业背景的优秀人才，具备一定数理分析能力，熟悉Python/C++等至少一门编程语言，具有编程实操经验；能运用AI工具搭建和管理知识库，有AI投研工具落地经验者优先，能主动使用大模型、Agent或自动化工具提升投研与交易支持效率；对自营投资、交易研究、投资组合管理有浓厚兴趣；具备良好的责任心、团队协作、沟通表达、逻辑分析与持续学习能力。","ClassificationOne":null,"ClassificationTwo":null,"Classification3":null,"Classification4":null,"Classification5":null,"Classification6":null,"FavoritesStatus":false,"Station":null,"Kind":null,"Channel4IsHot":true,"Channel4IsLong":false,"Status":1,"Channel4HasReward":false,"Channel4ExMicroRecommendScore":null,"Channel4ExMicroRecommendReward":null,"Channel4RewardDescription":null,"IsCollect":false,"IsDelivered":false,"SubmissionLimit":null,"BelongStoreId":null,"Degree":null,"YearsOfWorking":null,"WorkTime":null,"Insurance":null,"Welfare":null,"WorkWeChatQrCode":null,"Channel4IsAllowCampusRecommend":false,"Channel4CampusReward":null,"Channel4CampusScore":null,"Channel4CampusRewardDescription":null,"Channel4IsAllowExternalRecommend":false,"Channel4ExternalReward":null,"Channel4ExternalScore":null,"Channel4ExternalRewardDescription":null,"InnerChannelIsTop":true,"Channel4SequenceNumber":"1","ChangeDate":"2026-09-29T16:13:07","JobVideoJd":null,"IsAllowRepeatDeliverSameJob":false,"AllowRepeatDeliverCount":0,"RepeatDeliverCount":0,"IsShowReward":false,"DetailAddress":null},{"Id":"3fc3ced9-2c34-4796-ac9a-1acdec242dfa","HeadCount":0,"JobAdId":621151158,"PostDa